---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThreeHouseScene from '../components/ThreeHouseScene';

const description = '책상, 맥북, 아이폰을 클릭해 이력과 프로젝트를 탐색하는 3D 포트폴리오 룸입니다.';
---

<BaseLayout
  title="3D 포트폴리오 룸 | 한만욱"
  description={description}
  keywords={['Three.js', 'WebGL', 'Portfolio', 'Frontend']}
  showPet={false}
>
  <Header />

  <main class="site-main">
    <section class="wrap py-[clamp(34px,5vw,72px)]">
      <div class="mb-6">
        <div>
          <p class="eyebrow mb-3">WebGL Experiment</p>
          <h1 class="m-0 max-w-[13ch] text-[clamp(2.3rem,7vw,5.4rem)] font-bold leading-[0.92] tracking-[-0.06em]" style="color: var(--text);">
            3D Portfolio Room
          </h1>
        </div>
      </div>

      <ThreeHouseScene client:only="react" />
    </section>
  </main>

  <Footer />
</BaseLayout>
