---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThreeHouseScene from '../components/ThreeHouseScene';

const description = '데스크톱 화면을 클릭해 포트폴리오를 탐색하는 3D 소개 페이지입니다.';
---

<BaseLayout
  title="3D 소개 | 한만욱"
  description={description}
  keywords={['Three.js', 'WebGL', 'Portfolio', 'Frontend']}
  showPet={false}
>
  <Header />

  <main class="site-main">
    <section class="wrap py-[clamp(34px,5vw,72px)]">
      <div class="mb-6">
        <div>
          <p class="eyebrow mb-3">WebGL Introduction</p>
          <h1 class="m-0 max-w-[13ch] text-[clamp(2.3rem,7vw,5.4rem)] font-bold leading-[0.92] tracking-[-0.06em]" style="color: var(--text);">
            3D 소개
          </h1>
        </div>
      </div>

      <ThreeHouseScene client:only="react" />
    </section>
  </main>

  <Footer />
</BaseLayout>
