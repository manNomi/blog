---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  portfolioMetrics,
  portfolioProfile,
  portfolioProjects,
  resumeActivities,
  resumeEducation,
  resumeExperiences,
  resumeOpenSourceGroups,
  resumeSkillGroups
} from '../data/portfolio';

const featuredProjectSlugs = new Set(['i18nexus', 'solid-connection']);
const featuredProjects = portfolioProjects.filter((project) => featuredProjectSlugs.has(project.slug));
const otherProjects = portfolioProjects.filter((project) => !featuredProjectSlugs.has(project.slug));
const openSourceContributionCount = resumeOpenSourceGroups.reduce((total, group) => total + group.bullets.length, 0);
const currentExperience = resumeExperiences.find((experience) => experience.current);
---

<BaseLayout title="소개 | 한만욱" description={portfolioProfile.intro}>
  <Header />

  <main class="site-main about-page">
    <div class="wrap">
      <header class="about-hero rise">
        <div class="about-hero__copy">
          {currentExperience && (
            <p class="about-current-line">
              <span class="about-current-dot" aria-hidden="true"></span>
              <span>현재 {currentExperience.company}에서 일하고 있습니다.</span>
            </p>
          )}

          <h1>{portfolioProfile.headline}</h1>
          <p class="about-hero__intro">{portfolioProfile.intro}</p>

          <div class="about-hero__actions" aria-label="연락처와 외부 링크">
            <a href={`mailto:${portfolioProfile.email}`} class="about-primary-link">이메일 보내기</a>
            <a href={portfolioProfile.github} target="_blank" rel="noopener noreferrer" class="about-text-link">GitHub</a>
            <a href={portfolioProfile.blog} class="about-text-link">기술 글</a>
          </div>
        </div>

        {currentExperience && (
          <aside class="about-now" aria-label="현재 경력">
            <span class="about-now__label">NOW</span>
            <strong>{currentExperience.company}</strong>
            <span>{currentExperience.role}</span>
            <span class="mono">{currentExperience.period}</span>
          </aside>
        )}
      </header>

      <nav class="about-index" aria-label="소개 페이지 목차">
        <a href="#experience">경력</a>
        <a href="#projects">프로젝트</a>
        <a href="#open-source">오픈소스</a>
        <a href="#background">활동과 학력</a>
      </nav>

      <section class="about-impact" aria-labelledby="impact-title">
        <div class="about-section-heading">
          <h2 id="impact-title">대표 임팩트</h2>
          <p>사용자 경험과 팀의 개발 흐름에서 실제로 달라진 결과입니다.</p>
        </div>

        <div class="about-impact__grid">
          {portfolioMetrics.map((metric) => (
            <article class="about-impact__item">
              <strong>{metric.value}</strong>
              <h3>{metric.label}</h3>
              <p>{metric.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="experience" class="about-section scroll-mt-24">
        <div class="about-section-heading">
          <h2>경력</h2>
          <p>문제를 재현하고 측정한 뒤 팀이 다시 사용할 수 있는 구조로 남겼습니다.</p>
        </div>

        <div class="about-experience-list">
          {resumeExperiences.map((experience) => (
            <a
              href={`/about/${experience.slug}`}
              class:list={['about-experience-row', { 'about-experience-row--current': experience.current }]}
            >
              <span class="about-experience-row__period mono">{experience.period}</span>

              <span class="about-experience-row__content">
                <span class="about-experience-row__title">
                  {experience.logo && (
                    <span class={`company-logo company-logo--list company-logo--${experience.logo.shape}`} aria-hidden="true">
                      <img
                        src={experience.logo.src}
                        alt=""
                        width={experience.logo.width}
                        height={experience.logo.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )}
                  <span>
                    <strong>{experience.company}</strong>
                    {experience.current && <small>재직 중</small>}
                  </span>
                </span>

                <span class="about-experience-row__role">{experience.role}</span>
                <span class="about-experience-row__description">{experience.description}</span>

                <span class="about-experience-row__highlights">
                  {experience.highlights.slice(0, 3).map((highlight) => (
                    <span>
                      <b>{highlight.title}</b>
                      {highlight.metric && <small>{highlight.metric}</small>}
                    </span>
                  ))}
                </span>
              </span>

              <span class="about-row-action">상세 보기</span>
            </a>
          ))}
        </div>
      </section>

      <section id="projects" class="about-section scroll-mt-24">
        <div class="about-section-heading">
          <h2>대표 프로젝트</h2>
          <p>직접 운영하며 성능과 개발 생산성을 수치로 확인한 작업입니다.</p>
        </div>

        <div class="about-featured-projects">
          {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>

        <div class="about-project-archive">
          <h3>그 밖의 프로젝트</h3>
          <div>
            {otherProjects.map((project) => (
              <a href={`/about/${project.slug}`}>
                <span>
                  <strong>{project.title}</strong>
                  <small>{project.summary}</small>
                </span>
                <span class="mono">{project.period}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="open-source" class="about-section scroll-mt-24">
        <div class="about-section-heading">
          <h2>오픈소스</h2>
          <p>{resumeOpenSourceGroups.length}개 저장소에 {openSourceContributionCount}개의 변경을 제안했습니다.</p>
        </div>

        <div class="about-open-source-list">
          {resumeOpenSourceGroups.map((group) => {
            const repositoryLink = group.links?.find((link) => link.label.includes('저장소'));

            return (
              <article class="about-open-source-group">
                <header>
                  <div>
                    <h3>{group.title}</h3>
                    <p>{group.subtitle}</p>
                  </div>
                  {repositoryLink && (
                    <a href={repositoryLink.href} target="_blank" rel="noopener noreferrer">저장소 보기</a>
                  )}
                </header>

                <div class="about-open-source-prs">
                  {group.bullets.map((item) => (
                    <a href={item.href ?? repositoryLink?.href ?? '#'} target="_blank" rel="noopener noreferrer">
                      <span>
                        <strong>{item.title}</strong>
                        <small>{item.description}</small>
                      </span>
                      <span class="mono">{item.metric ?? 'PR'}</span>
                    </a>
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section id="background" class="about-section about-background scroll-mt-24">
        <div class="about-section-heading">
          <h2>활동과 학력</h2>
          <p>제품 개발 밖에서도 연구와 오픈소스 활동을 이어가고 있습니다.</p>
        </div>

        <div class="about-background__grid">
          <section>
            <h3>활동</h3>
            <ul>
              {resumeActivities.map((activity) => <li>{activity}</li>)}
            </ul>
          </section>

          <section>
            <h3>학력</h3>
            <strong>{resumeEducation.school}</strong>
            <p>{resumeEducation.major}</p>
            <span class="mono">{resumeEducation.period} / {resumeEducation.detail}</span>
          </section>

          <section>
            <h3>기술</h3>
            <div class="about-skill-groups">
              {resumeSkillGroups.map((group) => (
                <div>
                  <span class="mono">{group.title}</span>
                  <p>{group.items.join(', ')}</p>
                </div>
              ))}
            </div>
          </section>
        </div>
      </section>

      <section class="about-contact">
        <div>
          <h2>같이 풀어볼 문제가 있다면 연락해주세요.</h2>
          <p>제품 지표와 프론트엔드 구조를 함께 보는 일을 좋아합니다.</p>
        </div>
        <div>
          <a href={`mailto:${portfolioProfile.email}`} class="about-primary-link">{portfolioProfile.email}</a>
          <a href={portfolioProfile.github} target="_blank" rel="noopener noreferrer" class="about-text-link">GitHub</a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
