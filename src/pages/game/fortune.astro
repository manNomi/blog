---
import { sitePath } from '../../utils/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SajuLovePage from '../../components/SajuLovePage';
---

<BaseLayout title="운세보기 | Nomi Journal" description="시험운과 연애운을 단계형 입력으로 요청하는 미니게임">
  <Header />

  <main class="main-shell">
    <section class="container-shell">
      <div class="mx-auto max-w-[1080px]">
        <nav class="mb-4 flex flex-wrap gap-2" aria-label="게임 메뉴">
          <a href={sitePath('/game')} class="pill">게임 목록</a>
          <a href={sitePath('/game/compatibility')} class="pill">궁합 보기</a>
          <a href={sitePath('/game/dice')} class="pill">주사위 게임</a>
          <a href={sitePath('/game/ladder')} class="pill">사다리타기</a>
        </nav>

        {import.meta.env.PUBLIC_STATIC_BLOG ? (
          <p class="saju-card px-5 py-7">이메일 운세 리포트는 현재 제공하지 않습니다. 위 메뉴에서 다른 게임을 즐길 수 있습니다.</p>
        ) : (
          <SajuLovePage client:load />
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
